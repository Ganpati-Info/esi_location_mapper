# Copy the current pooled connection string from the Neon dashboard.
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Optional direct connection string for migrations or as a fallback.
DATABASE_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Required for production-quality address parsing/standardization.
# Mappls documents Address Analytics and Geocoding for Indian addresses.
MAPPLS_ACCESS_TOKEN=YOUR_MAPPLS_TOKEN

# Optional. Used only if you want Gemini to enrich fields that the
# address service cannot confidently extract. Never expose this to the browser.
GEMINI_API_KEY=YOUR_GEMINI_KEY

# Processing controls
MAX_UPLOAD_MB=25
BATCH_SIZE=10
MAPPLS_DELAY_MS=150

# Map page
NEXT_PUBLIC_MAP_DEFAULT_LAT=22.9734
NEXT_PUBLIC_MAP_DEFAULT_LNG=78.6569
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=5

# Optional OSM tile URL. This is map display only, not geocoding.
NEXT_PUBLIC_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors


# Required for production-quality address parsing/standardization.
# Mappls documents Address Analytics and Geocoding for Indian addresses.
MAPPLS_ACCESS_TOKEN=YOUR_MAPPLS_TOKEN

# Optional. Used only if you want Gemini to enrich fields that the
# address service cannot confidently extract. Never expose this to the browser.
GEMINI_API_KEY=YOUR_GEMINI_KEY